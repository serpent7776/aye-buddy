#!/usr/bin/env perl
# aye-netns-seal: aye-buddy's egress seal, run inside the net namespace.
#
# pasta spawns this inside the fresh user+net namespace (so it runs as root in
# that userns, with CAP_NET_ADMIN over the netns) BEFORE bwrap. It:
#   1. restricts routing so only the pasta gateway (where the host, and thus
#      aye-proxy, is mapped) is reachable — the wider internet AND the local
#      subnet lose their route (IPv4 and the IPv6 default too), so a raw-socket
#      reverse shell / LAN pivot can't connect. Then it probes the proxy, and
#      refuses to launch if it can't be reached. --no-lan-filter skips tightening
#      outright, leaving the on-link subnet routable straight past the proxy.
#      Finally it VERIFIES the seal actually holds — no route to the
#      wider internet survived — and refuses to launch if it can't prove that,
#      rather than run a session that looks filtered but isn't. It also installs
#      an nft filter dropping all but the proxy port on the gateway (so the pasta
#      host-loopback mapping can't expose other 127.0.0.1 host services) and
#      dropping all IPv6 egress — the proxy is IPv4-only, so no v6 path out (the
#      loopback mapping or a link-local gateway) is ever legitimate.
#   2. rewrites @@AYE_PROXY@@ in the target argv to the proxy URL and exports
#      HTTP(S)_PROXY, so both bwrap's --setenv values and plain clients pick it
#      up.
#   3. arms the seccomp blob and splices its fd into `bwrap --seccomp` — pasta
#      need not preserve inherited fds across exec, so we own that fd here.
# then execs the target (bwrap, or in the test harness a probe command).
use strict;
use warnings;
use FindBin qw($RealBin);
use lib $RealBin;
use AyeSeccomp qw(arm_seccomp SECCOMP_FD_TOKEN PROXY_TOKEN);
use IO::Socket::INET ();

sub die_h { print STDERR "aye-netns-seal: $_[0]\n"; exit 1 }
sub warn_h { print STDERR "aye-netns-seal: $_[0]\n" }

# A real TCP port. An out-of-range value would reach nft as `tcp dport N` and
# fail the whole ruleset, silently dropping the loopback/IPv6 hardening.
sub valid_port { $_[0] =~ /\A[0-9]+\z/ && $_[0] >= 1 && $_[0] <= 65535 }

# argv: PROXY_PORT  SECCOMP(-|path)  [--no-lan-filter]  --  CMD [ARG...]
my $port    = shift // die_h('usage: aye-netns-seal PORT SECCOMP [--no-lan-filter] -- CMD...');
valid_port($port) or die_h("proxy port '$port' not a valid TCP port (1-65535)");
my $seccomp = shift // die_h('missing SECCOMP argument (path or -)');
my $no_lan_filter = 0;
if (@ARGV && $ARGV[0] eq '--no-lan-filter') { $no_lan_filter = 1; shift }
my $sep     = shift // '';
$sep eq '--' or die_h('expected -- separator before the command');
my @cmd = @ARGV;
@cmd or die_h('no command to exec');

# Discover the gateway and interface pasta configured.
my $default = qx(ip -4 route show default 2>/dev/null);
my ($gwaddr, $ifc) = $default =~ /default via (\S+) dev (\S+)/;
$gwaddr && $ifc or die_h('no default route present (is pasta --config-net active?)');

# Name the on-link (subnet) routes before touching anything: the tightening below
# deletes them by prefix, and this is the only place they're enumerated.
my @link = grep { /\S/ } split /\n/, qx(ip -4 route show scope link dev $ifc 2>/dev/null);

# Drop the default route: the wider internet must have no path out. This is the
# linchpin of the seal, so don't trust a single del — a route named differently,
# a multipath default, or a non-zero exit could leave one behind. Loop until
# `show default` is empty (or we give up); the seal check below is the backstop.
for (1 .. 8) {
    last unless qx(ip -4 route show default 2>/dev/null) =~ /\S/;
    system('ip', 'route', 'del', 'default');
}

# Same for IPv6: pasta is dual-stack by default, and the proxy is IPv4-only, so
# a surviving v6 default route would be an unfiltered path around it. Drop it too
# (a no-op on IPv4-only hosts; link-local stays, only the egress path goes).
for (1 .. 8) {
    last unless qx(ip -6 route show default 2>/dev/null) =~ /\S/;
    system('ip', '-6', 'route', 'del', 'default');
}

# Tighten to a single gateway host-route unless the caller opted out: remove the
# auto on-link subnet route too, leaving ONLY the gateway (= proxy) reachable, so
# same-subnet LAN hosts lose their route as well. Then verify the proxy is still
# reachable, and fail closed if it isn't. Widening back to the subnet route can't
# be the fix: the /32 is more specific than the prefix it replaces and on the same
# device, so the prefix was already shadowed for gateway traffic. Restoring it
# would hand the session the LAN to cover for a proxy path that stays broken.
unless ($no_lan_filter) {
    system('ip', 'route', 'replace', "$gwaddr/32", 'dev', $ifc);
    for my $r (@link) {
        my ($pfx) = split ' ', $r;
        system('ip', 'route', 'del', $pfx, 'dev', $ifc)
            if $pfx && $pfx ne "$gwaddr/32";
    }
    # Don't point at --no-lan-filter here: by the same argument the proxy path is
    # broken for a reason keeping the subnet route won't mend, and that flag skips
    # this probe, so it would trade a clear failure for a session that launches
    # with the LAN open and still no proxy.
    gateway_reachable($gwaddr, $port) or die_h(
        "proxy unreachable at $gwaddr:$port after tightening; refusing to launch.\n" .
        "  Re-run with --no-net-filter to run WITHOUT egress filtering.");
}

# Positive seal verification: prove the netns has no route to the wider internet
# before we hand it a shell. A silently-failed del or an unexpected surviving
# route would otherwise run a session that looks filtered but lets a reverse
# shell straight out — the exact fail-open C1 warns about. Fail closed instead.
egress_sealed() or die_h(
    "egress seal unverified — a route to the internet survived; refusing to launch.\n" .
    "  Re-run with --no-net-filter to run WITHOUT egress filtering.");

# Close the host-loopback side channel (M1). pasta maps the gateway address to
# the host's loopback for ALL ports, so with only the gateway routable a session
# could still reach any 127.0.0.1 service on the host (a local DB, another proxy,
# a metadata mock) — a pivot/exfil surface the route seal doesn't cover. Drop
# every packet to the gateway except the proxy port, leaving the proxy as the
# only thing the host exposes. Surgical (only the gateway address is touched), so
# it composes with --no-lan-filter, whose LAN traffic goes to other addresses.
# Best-effort: unlike the internet seal this is secondary hardening, so if nft is
# absent or the rules don't take we warn and carry on rather than refuse to
# launch — the internet is still sealed either way.
restrict_gateway_to_proxy($gwaddr, $port);

# TCP-connect probe to the proxy: a plain reachability check (aye-proxy accepts
# the connection and we drop it without a CONNECT).
sub gateway_reachable {
    my ($host, $p) = @_;
    my $s = IO::Socket::INET->new(PeerHost => $host, PeerPort => $p,
        Proto => 'tcp', Timeout => 3);
    return 0 unless $s;
    close $s;
    return 1;
}

# The seal holds iff, for BOTH IPv4 and IPv6, (a) no default route remains — the
# only path a raw socket has to an arbitrary internet host, since we never add a
# specific public route — and (b) the kernel has no concrete route to a
# documentation address (RFC 5737 TEST-NET-3 / RFC 3849 2001:db8::/32, reserved
# so they can never collide with a real subnet, even under --no-lan-filter). Any
# surviving route to one means egress is open.
sub egress_sealed {
    for my $p (['-4', '203.0.113.1'], ['-6', '2001:db8::1']) {
        my ($fam, $probe) = @$p;
        return 0 if qx(ip $fam route show default 2>/dev/null) =~ /\S/;
        return 0 if qx(ip $fam route show 2>/dev/null) =~ /\bvia\b/;
        my $r = qx(ip $fam route get $probe 2>&1);
        return 0 if $? == 0 && $r =~ /\bdev\b/;
    }
    return 1;
}

# Install an nft OUTPUT filter: allow only tcp/$p to the gateway, drop everything
# else addressed to it, and drop all IPv6 egress (netns loopback stays up). The
# proxy is IPv4-only, so v6 has no legitimate path out — this closes the v6 twin
# of the host-loopback side channel the v4 rule handles. Policy stays accept so
# other v4 traffic is governed by routing alone.
sub restrict_gateway_to_proxy {
    my ($gw, $p) = @_;
    $gw =~ /\A[0-9.]+\z/    or return warn_h("gateway '$gw' not an IPv4 literal; skipping loopback hardening");
    my $skipped = "host-loopback and IPv6 side channels stay reachable (the internet route seal still holds)";
    # If nft is missing the piped child's exec fails and the write below hits a
    # dead pipe; ignore SIGPIPE so that degrades to a warning instead of killing
    # the helper (which would abort the whole launch).
    local $SIG{PIPE} = 'IGNORE';
    my $ok = open(my $nft, '|-', 'nft', '-f', '-');
    $ok or return warn_h("nft unavailable; $skipped");
    print $nft <<"NFT";
table inet aye_egress {
    chain output {
        type filter hook output priority 0; policy accept;
        oif "lo" accept
        ip daddr $gw tcp dport $p accept
        ip daddr $gw drop
        meta nfproto ipv6 drop
    }
}
NFT
    close $nft or return warn_h("nft rules did not apply; $skipped");
    # A rule quirk that broke proxy reachability would break every session; drop
    # our table and degrade rather than wedge the sandbox.
    gateway_reachable($gw, $p) or do {
        system('nft', 'delete', 'table', 'inet', 'aye_egress');
        warn_h("proxy unreachable after loopback hardening; removed it — $skipped");
    };
}

# Point clients at the proxy (reached via the gateway, which pasta maps to the
# host where aye-proxy listens).
my $url = "http://$gwaddr:$port";
$_ eq PROXY_TOKEN and $_ = $url for @cmd;
$ENV{$_} = $url for qw(HTTP_PROXY HTTPS_PROXY http_proxy https_proxy);

# $keep stays in scope until exec so the fd survives into bwrap.
my $keep;
if ($seccomp ne '-') {
    $keep = eval { arm_seccomp(\@cmd, $seccomp) }
        or die_h($@ =~ s/\n\z//r);
}

exec { $cmd[0] } @cmd or die_h("exec $cmd[0]: $!");
