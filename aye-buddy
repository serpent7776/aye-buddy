#!/usr/bin/env perl
# aye-buddy: run claude in a sandbox.

use strict;
use warnings;
use Cwd ();
use POSIX ();
use Errno qw(EINTR);
use Fcntl qw(F_SETFD);
use IO::Socket::INET;
use Getopt::Long qw(GetOptions);
use FindBin qw($RealBin);
use lib $RealBin;
use AyeSeccomp qw(arm_seccomp SECCOMP_FD_TOKEN PROXY_TOKEN);
use File::Path qw(make_path);
use File::Basename qw(dirname);
use File::Temp ();

our $VERSION = '0.1.0';

sub fail { print STDERR "aye-buddy: $_[0]\n"; exit 1 }
sub warning { print STDERR "aye-buddy: warning: $_[0]\n" }

# Values we echo back — argv, the project path — can carry terminal escapes, so
# reduce them to printable ASCII first. Keeping non-ASCII would mean deciding it
# per character, not per byte: U+009B is CSI once a terminal has decoded the
# UTF-8, and the bytes that encode it are the bytes every other character uses.
# Only the value goes through this, never the surrounding message.
sub printable {
    (my $s = shift) =~ s/[^\x20-\x7e]/?/g;
    return $s;
}

sub on_path {
    my ($cmd) = @_;
    for my $d (split /:/, $ENV{PATH} // '') {
        next unless length $d;
        return 1 if -x "$d/$cmd";
    }
    return 0;
}

# Supported agents. Each entry names the binary to run plus the fixed args and
# env aye-buddy injects for it; --agent picks one (default claude).
my %AGENTS = (
    claude => {
        bin  => 'claude',
        args => ['--dangerously-skip-permissions',
                 '--settings', '{"sandbox":{"enabled":false}}'],
        # Tell claude it's already inside an external sandbox so it skips the
        # workspace trust dialog (the bwrap boundary is the real trust decision),
        # and stop non-essential telemetry/error egress at the source.
        env  => {
            CLAUDE_CODE_SANDBOXED   => '1',
            DISABLE_TELEMETRY       => '1',
            DISABLE_ERROR_REPORTING => '1',
        },
    },
);

sub usage {
    my $agents = join(', ', sort keys %AGENTS);
    print <<"USAGE";
aye-buddy $VERSION - run a coding agent in a sandbox

usage: aye-buddy [OPTION...] [--] [AGENT ARG...]

Runs the agent under bwrap so the session sees only the current project, and
filters its network egress through a bundled allowlist proxy. aye-buddy's own
options go before the agent's arguments; `--` ends them explicitly.

options:
  --agent NAME              agent to run (supported: $agents) [default: claude]
  --bind PATH               expose an extra host path read-write at the same
                            path inside the sandbox (repeatable)
  --bind-ro PATH            same, read-only (repeatable)
  --allow-host HOST[:PORT]  add a host to the egress allowlist, matched exactly;
                            .HOST covers its subdomains too, and without a port
                            only 443 is allowed (repeatable)
  --no-net-filter           turn off egress filtering, use the host network
  --allow-subnet            keep same-subnet (LAN) hosts reachable
  --allow-reserved          let an allowlisted name resolve to a loopback or
                            private address (for split-horizon DNS)
  --allow-ssh               forward the host SSH agent socket into the session;
                            the agent then signs for any host, not just git
  --allow-bwrap             let the session run bwrap itself (nested
                            sandboxing); reduces isolation
  --help                    show this help and exit
  --version                 show the version and exit

To reach the agent's own --help, put it after the separator:
  aye-buddy -- --help
USAGE
    exit 0;
}

# Parse aye-buddy's own options off the front of @ARGV; the rest forwards to
# claude. require_order stops at the first non-option and pass_through leaves the
# remainder in @ARGV; no_auto_abbrev/no_ignore_case keep our flags exact-match so
# a claude arg can't accidentally trigger one (e.g. `--all` is not --allow-bwrap).
#   --agent NAME selects which agent to run (default claude). NAME must be a key
#     of %AGENTS above; an unknown one fails rather than reaching bwrap.
#   --allow-bwrap lets the sandboxed claude run bwrap itself (nested sandboxing):
#     opt-in, it widens the syscall surface and forces Landlock off, leaving the
#     bwrap mount-namespace allowlist as the only outer wall.
#   --bind/--bind-ro PATH expose an extra host path at the same path inside the
#     sandbox (rw/ro). Repeatable. Resolved below so claude never sees them. `:s`
#     (optional value) so a missing PATH lands as '' we can reject, rather than
#     swallowing the next flag as the path.
#   --allow-host HOST[:PORT] adds an extra host to the network egress allowlist
#     on top of the builtin defaults. Repeatable; same `:s` reasoning.
#   --net-filter / --no-net-filter toggles the egress filter (default on). When
#     on, the session reaches the network only through the bundled proxy, so a
#     reverse shell has no route out; --no-net-filter falls back to --share-net.
#   --allow-subnet keeps same-subnet (LAN) hosts reachable under the filter.
#     Default routing tightens to the proxy only; this is the escape hatch for
#     workloads that need a LAN host, or setups where tightening is too strict.
#   --allow-reserved lets an allowlisted name resolve into loopback/RFC1918 and
#     still be dialled. Off by default: the proxy connects from the host, outside
#     the seal, so a rebound name would otherwise reach services the session has
#     no route to. An entry naming an address literally works either way.
#   --allow-ssh forwards $SSH_AUTH_SOCK into the sandbox. Opt-in because an agent
#     can't scope a signature to one destination: the session can have the host
#     agent authenticate to anything it can reach, for the session's lifetime.
Getopt::Long::Configure(qw(require_order pass_through no_auto_abbrev no_ignore_case));
my $allow_bwrap  = 0;
my $net_filter   = 1;
my $allow_subnet = 0;
my $allow_reserved = 0;
my $allow_ssh    = 0;
my $agent        = 'claude';
my ($show_help, $show_version);
my (@extra_rw, @extra_ro, @extra_hosts);
my %opt_spec = ('allow-bwrap'  => \$allow_bwrap,
               'net-filter!'   => \$net_filter,
               'allow-subnet'  => \$allow_subnet,
               'allow-reserved' => \$allow_reserved,
               'allow-ssh'     => \$allow_ssh,
               'agent=s'       => \$agent,
               'bind:s'        => \@extra_rw,
               'bind-ro:s'     => \@extra_ro,
               'allow-host:s'  => \@extra_hosts,
               'help'          => \$show_help,
               'version'       => \$show_version);
GetOptions(%opt_spec) or fail("invalid aye-buddy option");
# Answer these before touching the environment, so they work on a host that
# lacks bwrap or the agent. `aye-buddy -- --help` still reaches the agent.
print("aye-buddy $VERSION\n"), exit 0 if $show_version;
usage() if $show_help;
# The flags we own, derived from the specs above so there's one source of truth.
# A `!` spec (net-filter) also owns its --no- form.
my %our_flag;
for my $spec (keys %opt_spec) {
    (my $name = $spec) =~ s/[=:!].*//;
    $our_flag{"--$name"} = 1;
    $our_flag{"--no-$name"} = 1 if $spec =~ /!/;
}
on_path('bwrap') or fail("required command not found on PATH: bwrap");
my $agent_spec = $AGENTS{$agent}
    or fail("unknown agent: " . printable($agent)
          . " (supported: " . join(', ', sort keys %AGENTS) . ")");
on_path($agent_spec->{bin})
    or fail("required command not found on PATH: $agent_spec->{bin}");
# pass_through leaves a leading `--` in place; consume it as our separator so a
# literal `--allow-bwrap` etc. can still reach claude untouched.
my $saw_sep = (@ARGV && $ARGV[0] eq '--') ? do { shift @ARGV; 1 } : 0;
# Without an explicit `--`, an aye-buddy flag among the leftover claude args is a
# misplaced flag, not a claude one: fail loudly rather than forward it silently.
if (!$saw_sep) {
    for my $arg (@ARGV) {
        # --bind=PATH is as much ours as --bind PATH, so match on the name only.
        (my $flag = $arg) =~ s/=.*//s;
        next unless $our_flag{$flag};
        fail(printable($arg) . " is an aye-buddy flag but came after the agent's " .
             "arguments;\n  move it before them, or use `--` to force it through " .
             "to the agent.");
    }
}
# Resolve each extra path to an absolute, existing one. abs_path still returns a
# path for a missing leaf or a broken symlink (only a missing *intermediate*
# gives undef), so -e guards against a cryptic bwrap "no such file" abort later.
sub resolve_bind {
    my ($flag, $path) = @_;
    length $path or fail("$flag requires a PATH argument");
    # LL_RW/LL_RO are newline-joined, so a newline in a path would split it into
    # two bogus Landlock entries and silently drop the real grant.
    $path =~ /[\r\n]/ and fail("$flag: path may not contain a newline: " . printable($path));
    my $abs = Cwd::abs_path($path) // fail("$flag: cannot resolve path: " . printable($path));
    -e $abs or fail("$flag: no such path: " . printable($path));
    return $abs;
}
@extra_rw = map { resolve_bind('--bind',    $_) } @extra_rw;
@extra_ro = map { resolve_bind('--bind-ro', $_) } @extra_ro;

# Validate each --allow-host value: a hostname or literal IP, optionally with a
# :PORT and optionally prefixed with a dot to cover subdomains too.
# Reject junk here rather than letting it reach the filter as a rule.
sub validate_allow_host {
    my ($host) = @_;
    length $host or fail("--allow-host requires a HOST argument");
    # we don't support IPv6, so just reject it
    $host =~ /[\[\]]|:.*:/
        and fail("--allow-host: IPv6 literals are unsupported (egress is IPv4-only): "
               . printable($host));
    $host =~ /\A\.?[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*(?::[0-9]+)?\z/
        or fail("--allow-host: invalid host (want HOST, .HOST for subdomains, "
              . "either with an optional :PORT): " . printable($host));
    # A dotted entry needs a domain under it: a typo-catcher for a stray '.com',
    # not a public-suffix check ('.co.uk' and friends still pass).
    $host =~ /\A\.[^.:]+(?::|\z)/
        and fail("--allow-host: .HOST needs at least two labels (want "
               . ".example.com, not a bare suffix): " . printable($host));
    return $host;
}
@extra_hosts = map { validate_allow_host($_) } @extra_hosts;

# --- Network egress policy ------------------------------------------------
# The canonical allowlist of hosts a session may reach. The filtering layer
# (a netns whose only uplink is a proxy that enforces this list — wired
# separately) is generated from here, so this is the single source of truth.
# Kept deliberately small: every reachable host is also a possible exfil/C2
# destination, so the default set is only what a session genuinely needs.
# SSH git hosts are intentionally absent — reaching them is the raw-TCP lane
# (opened per host), because an open host:22 doubles as a reverse-shell target.
# An entry matches that exact hostname only, so every host a toolchain talks to
# has to be named here. The '.example.com' form covers subdomains too, reaching
# whatever they serve on the allowed port, so the defaults don't use it.
my @default_allow_hosts = (
    # Claude API and OAuth — without these the session can't run.
    'api.anthropic.com',
    'platform.claude.com',
    'console.anthropic.com',
    # npm
    'registry.npmjs.org',
    # PyPI
    'pypi.org',
    'files.pythonhosted.org',
    # crates.io: sparse index and crate downloads live on their own hosts
    'crates.io',
    'index.crates.io',
    'static.crates.io',
    # Go modules
    'proxy.golang.org',
    'sum.golang.org',
    # git over HTTPS (SSH hosts go through --allow-host, not here)
    'github.com',
    'codeload.github.com',
    'raw.githubusercontent.com',
    'media.githubusercontent.com',
    'objects.githubusercontent.com',
    'objects-origin.githubusercontent.com',
    'gitlab.com',
    'codeberg.org',
);
my @allow_hosts = (@default_allow_hosts, @extra_hosts);
print STDERR "aye-buddy: egress allowlist: ", join(', ', @allow_hosts), "\n"
    if $ENV{AYE_BUDDY_DEBUG};

my $self_dir     = $RealBin;
my $landlock     = "$self_dir/aye-landlock";
my $proxy_helper = "$self_dir/aye-proxy";
my $netns_seal   = "$self_dir/aye-netns-seal";

# Check egress filtering requirements
if ($net_filter) {
    on_path('pasta') or fail("--net-filter needs pasta (passt); install it or pass --no-net-filter");
    on_path('ip')    or fail("--net-filter needs ip (iproute2); install it or pass --no-net-filter");
    -r $proxy_helper or fail("egress proxy not found: $proxy_helper");
    -r $netns_seal   or fail("egress netns seal not found: $netns_seal");
}
# Under --allow-bwrap the relaxed blob re-allows the mount/namespace syscalls a
# nested bwrap needs; everything else stays denied.
my $seccomp_blob = $allow_bwrap ? "$self_dir/filter-nested.bpf"
                                : "$self_dir/filter.bpf";

# Where aye-landlock is mounted *inside* the sandbox.
my $landlock_dest = '/tmp/.aye-buddy-landlock';

my $use_landlock = 1;
if (!-r $landlock) {
    warning("aye-landlock not found ($landlock); Landlock layer off");
    $use_landlock = 0;
}

# A nested bwrap mounts fresh tmpfs and pivot_roots into a new root; those inodes
# sit beneath no path in the Landlock ruleset, so the ruleset would deny the
# inner sandbox's own files and break it. Drop Landlock for the session — the
# bwrap mount-namespace allowlist still bounds what's visible.
if ($allow_bwrap) {
    warning("--allow-bwrap: nested bwrap enabled — mount/namespace syscalls "
          . "permitted and Landlock disabled; isolation is reduced");
    $use_landlock = 0;
}

# Find the project root by walking up from CWD with a plain stat walk. We avoid
# `git`/`jj` here: running them on the host would parse the project's .git/config
# (core.fsmonitor, config-parsing CVEs) and could execute code before the sandbox
# exists. A stat walk has no such surface.
my $cwd = Cwd::abs_path('.') // fail("cannot resolve current directory");
my $project_dir;
{
    my $dir = $cwd;
    while ($dir ne '/') {
        if (-e "$dir/.git" || -d "$dir/.jj") {
            $project_dir = $dir;
            last;
        }
        $dir = dirname($dir);
    }
}
fail(printable($cwd) . " is not inside a git or jj repository")
    unless defined $project_dir;

# A linked worktree (or submodule) has `.git` as a FILE pointing OUTSIDE this
# directory. We only bind project_dir, so that target is unreachable and every
# git command inside the sandbox fails. Refuse rather than launch a sandbox where
# git silently breaks. (Real fix: bind the worktree gitdir + commondir too — TODO.)
if (-f "$project_dir/.git") {
    fail(printable($project_dir) . " is a git worktree or submodule (.git is a file\n" .
         "  pointing outside this directory); git won't work inside the sandbox.\n" .
         "  Not supported yet — run aye-buddy from the main checkout instead.");
}

my $home = $ENV{HOME} // fail("HOME is not set");
make_path("$home/.claude");
# A relative XDG_CACHE_HOME is invalid per the spec; ignore it
my $xdg_cache = $ENV{XDG_CACHE_HOME};
my $cache_dir = (defined $xdg_cache && $xdg_cache =~ m{^/} ? $xdg_cache
                                                          : "$home/.cache") . '/aye-buddy';
make_path($cache_dir);
-d $cache_dir or fail("cannot create the sandbox cache dir: $cache_dir");
my $claude_json = "$home/.claude.json";
unless (-e $claude_json) {
    open(my $fh, '>', $claude_json) or fail("cannot create $claude_json: $!");
    close $fh;
}

my (@args, @ll_rw, @ll_ro);
sub bind_rw  { my ($s, $d) = @_; $d //= $s; push @args, '--bind',        $s, $d; push @ll_rw, $d }
sub bind_ro  { my ($s, $d) = @_; $d //= $s; push @args, '--ro-bind',     $s, $d; push @ll_ro, $d }
sub try_ro   { my ($s, $d) = @_; $d //= $s; push @args, '--ro-bind-try', $s, $d; push @ll_ro, $d }
sub mount_rw { push @args, $_[0], $_[1];                  push @ll_rw, $_[1] } # --tmpfs/--proc/--dev
sub link_to  { push @args, '--symlink',     $_[0], $_[1] }

push @args, '--clearenv';   # must come before any --setenv (bwrap is order-sensitive)

bind_ro('/usr');
bind_ro('/etc');
try_ro('/opt');
try_ro('/nix');
link_to('usr/bin',   '/bin');
link_to('usr/lib',   '/lib');
link_to('usr/lib64', '/lib64');
mount_rw('--proc',  '/proc');
# /sys not mounted deliberately, add specific paths if needed
mount_rw('--dev',   '/dev');
mount_rw('--tmpfs', '/tmp');
mount_rw('--tmpfs', $home);
bind_rw($project_dir);
# User-requested extra paths, at the same path inside the sandbox. Bound before
# the ro overlays below so those guards still win where a bind overlaps them.
bind_rw($_) for @extra_rw;
bind_ro($_) for @extra_ro;
# Host git runs .git/hooks scripts and .git/config knobs (core.fsmonitor,
# core.sshCommand, bang-aliases) next time the user touches the repo outside the
# sandbox. Keep them ro so a session can't plant code the host will later run.
# Same for submodule git dirs under .git/modules/.
try_ro("$project_dir/.git/hooks");
try_ro("$project_dir/.git/config");
try_ro("$project_dir/.git/modules");
# ~/.claude is rw because claude writes to many subpaths (sessions/, projects/,
# history.jsonl, .credentials.json on OAuth refresh, ...). The paths that could
# let a session inject code into a later host-side `claude` are ro-overlaid below:
# settings, slash commands, agents, plugins, hooks, ~/.claude/scripts/, and MCP
# configs. Paths absent at launch fall through to rw — create empty placeholders
# on the host for strict enforcement before they exist.
bind_rw("$home/.claude");
try_ro("$home/.claude/settings.json");
try_ro("$home/.claude/settings.local.json");
try_ro("$home/.claude/commands");
try_ro("$home/.claude/agents");
try_ro("$home/.claude/plugins");
try_ro("$home/.claude/hooks");
try_ro("$home/.claude/scripts");
try_ro("$home/.claude/mcp.json");
try_ro("$home/.claude/.mcp.json");
bind_rw($claude_json);
bind_rw($cache_dir, "$home/.cache");
try_ro("$home/.gitconfig");
try_ro("$home/.config/git");
try_ro("$home/.ssh/config");
try_ro("$home/.ssh/known_hosts");

# Bind the helper at $landlock_dest for the in-sandbox `perl` to read. RO — never written.
if ($use_landlock) {
    bind_ro($landlock, $landlock_dest);
}

# Agent forwarding, opt-in. Fixed path inside the sandbox so the env var doesn't
# leak the host-side socket path.
if ($allow_ssh) {
    my $ssh_sock = $ENV{SSH_AUTH_SOCK};
    if (defined $ssh_sock && length $ssh_sock && -S $ssh_sock) {
        warning("--allow-ssh: the session can have your SSH agent authenticate "
              . "to any host it reaches, not just git remotes");
        bind_rw($ssh_sock, '/run/ssh-agent');
        push @args, '--setenv', 'SSH_AUTH_SOCK', '/run/ssh-agent';
    }
    else {
        warning("--allow-ssh: no agent socket at SSH_AUTH_SOCK; nothing forwarded");
    }
}

# Reintroduce any required env var
my $user    = $ENV{USER}    // (getpwuid($>))[0];
my $logname = $ENV{LOGNAME} // $user;
push @args,
    '--setenv', 'HOME', $home,
    '--setenv', 'USER', $user,
    '--setenv', 'LOGNAME', $logname,
    '--setenv', 'PATH', '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl',
    '--setenv', 'PWD', $project_dir,
    '--setenv', 'TERM', ($ENV{TERM} // 'xterm'),
    '--setenv', 'LANG', ($ENV{LANG} // 'C.UTF-8');
# Point the toolchains that don't follow XDG at the persistent cache
push @args,
    '--setenv', 'npm_config_cache', "$home/.cache/npm",
    '--setenv', 'CARGO_HOME',       "$home/.cache/cargo",
    '--setenv', 'GOPATH',           "$home/.cache/go";
# Agent-specific env from %AGENTS (e.g. claude's sandbox/telemetry hints). Sorted
# so the constructed argv is deterministic for the tests.
for my $k (sort keys %{$agent_spec->{env}}) {
    push @args, '--setenv', $k, $agent_spec->{env}{$k};
}
for my $var (qw(LC_ALL LC_CTYPE LC_MESSAGES LC_NUMERIC LC_TIME LC_COLLATE
                LC_MONETARY COLORTERM NO_COLOR)) {
    my $val = $ENV{$var};
    push @args, '--setenv', $var, $val if defined $val && length $val;
}

# Hand aye-landlock the permitted paths (newline-separated) accumulated above. Once
# the ruleset is enforced everything else is denied, so the lists must also cover
# the synthetic mounts (/tmp, /proc, /dev, the tmpfs $HOME). Paths resolve inside
# the sandbox: "$HOME" is the tmpfs, not host home, so granting it rw exposes
# nothing real. RO entries nested under an rw path reinforce bwrap's read-only
# bind where Landlock honours the more-specific rule, and are a no-op otherwise.
if ($use_landlock) {
    push @args,
        '--setenv', 'LL_RW', join("\n", @ll_rw),
        '--setenv', 'LL_RO', join("\n", @ll_ro);
}

# uname -m -> audit arch magic, for the arches gen-seccomp.c builds into the blob.
my %audit_arch = (
    x86_64  => 0xC000003E,                                      # x32 reports x86_64 too
    i386 => 0x40000003, i486 => 0x40000003,
    i586 => 0x40000003, i686 => 0x40000003,
    aarch64 => 0xC00000B7,
    armv6l  => 0x40000028, armv7l => 0x40000028, armv8l => 0x40000028,
    ppc64le => 0xC0000015,
    riscv64 => 0xC00000F3,
    loongarch64 => 0xC0000102,
);

# True only if the blob has a real dispatch block for this host's arch. A seccomp
# filter matches seccomp_data.arch and falls through to its default action (ALLOW)
# for any arch it wasn't built for — so on an uncovered arch the blob is a silent
# no-op. We read the blob rather than trust a static list, so this can't drift out
# of sync with gen-seccomp.c and reopen that silent hole.
sub seccomp_covers_host {
    my ($blob) = @_;
    my $machine = (POSIX::uname())[4];
    my $magic = $audit_arch{$machine};
    return (0, $machine) unless defined $magic;
    open my $fh, '<:raw', $blob or return (0, $machine);
    my $prog = do { local $/; <$fh> };
    # sock_filter = { u16 code; u8 jt; u8 jf; u32 k }, little-endian (generated on
    # x86_64; every covered arch is LE). The preamble BPF_JEQs seccomp_data.arch
    # against each covered arch's magic; a BPF_JEQ carrying ours means a real
    # dispatch block exists. The magics are distinctive enough that no syscall-nr
    # or clone-flag comparison collides with them.
    for (my $i = 0; $i + 8 <= length $prog; $i += 8) {
        my ($code, $k) = unpack('v x2 V', substr($prog, $i, 8));  # code, k
        return (1, $machine) if $code == 0x15 && $k == $magic;    # BPF_JMP|JEQ|K
    }
    return (0, $machine);
}

# Apply the seccomp denylist to the payload. bwrap installs it after building the
# sandbox (so it doesn't block bwrap's own unshare/mount) and reads it from an
# inherited fd. We pass a placeholder for the fd number now; whichever process
# execs bwrap arms the blob and rewrites the token to its own fd.
my $use_seccomp = 0;
if (-r $seccomp_blob) {
    # Fail closed: refuse to launch rather than run with a seccomp layer that this
    # arch would silently ignore. Regenerate the blob (make seccomp) for the arch.
    my ($covered, $machine) = seccomp_covers_host($seccomp_blob);
    $covered or fail("seccomp blob doesn't cover this machine's architecture" .
                     " ($machine), so the syscall filter can't be enforced here.\n" .
                     "  please open an issue in the aye-buddy repo reporting the" .
                     " '$machine' architecture so support can be added.");
    $use_seccomp = 1;
    push @args, '--seccomp', SECCOMP_FD_TOKEN;
} else {
    warning("seccomp blob not found ($seccomp_blob); seccomp layer off");
}

# Payload: run the agent directly, or wrap it in aye-landlock so Landlock is applied
# to the final sandbox view and inherited down into the agent and its children.
my @payload = (
    $agent_spec->{bin},
    @{$agent_spec->{args}},
    @ARGV,
);
if ($use_landlock) {
    @payload = ('perl', $landlock_dest, '--', @payload);
}

# Point claude's clients at the proxy. aye-netns-seal rewrites @@AYE_PROXY@@ to
# the real URL inside the netns (only there is the gateway address known), and
# --clearenv above means these are the only proxy vars the session sees.
if ($net_filter) {
    push @args,
        '--setenv', 'HTTP_PROXY',  PROXY_TOKEN,
        '--setenv', 'HTTPS_PROXY', PROXY_TOKEN,
        '--setenv', 'http_proxy',  PROXY_TOKEN,
        '--setenv', 'https_proxy', PROXY_TOKEN;
}

push @args,
    '--chdir', $project_dir,
    '--unshare-user',
    '--unshare-pid',
    '--unshare-ipc',
    # Private UTS namespace so sethostname/setdomainname can't touch the host's.
    # The seccomp denylist also blocks those calls — defense in depth.
    '--unshare-uts';
# Network namespace. With filtering, bwrap inherits pasta's netns (pasta is the
# parent and owns the only uplink — the filtering proxy); without it, share the
# host's network directly.
if ($net_filter) {
    # pasta runs us in a userns where our euid is 0. bwrap's nested userns can
    # label its single mapped uid however we like, so pin the sandbox uid/gid to
    # the real host user: claude then sees a normal (non-root) uid — still backed
    # through pasta -> host as the same unprivileged user — and project files
    # (owned by the host uid) show the right owner. Without this the session runs
    # as uid 0, which claude refuses for --dangerously-skip-permissions.
    push @args, '--uid', POSIX::getuid(), '--gid', POSIX::getgid();
} else {
    push @args, '--share-net';
}
push @args,
    # New session (setsid) so the process has no controlling terminal and can't
    # use the TIOCSTI ioctl to inject keystrokes into the host shell — the classic
    # interactive-sandbox escape. bwrap reconnects stdio so the TUI still works.
    '--new-session',
    '--die-with-parent',
    '--',
    @payload;

# Unfiltered path: arm the seccomp blob (splices its fd into @args for the
# placeholder) and exec bwrap directly. Never returns.
sub launch_unfiltered {
    # $seccomp_fh must stay in scope until exec so the kernel doesn't close the
    # fd out from under bwrap.
    my $seccomp_fh;
    if ($use_seccomp) {
        $seccomp_fh = eval { arm_seccomp(\@args, $seccomp_blob) }
            or fail($@ =~ s/\n\z//r);
    }
    exec { 'bwrap' } 'bwrap', @args
        or fail("exec bwrap: $!");
}

sub spawn_proxy {
    my ($sock, $log) = @_;
    my $pid = fork // return;
    if ($pid == 0) {
        open(STDOUT, '>>', $log);
        open(STDERR, '>>', $log);    # best-effort; keep denials off the TUI
        # Perl marks the fd close-on-exec; clear that so the proxy inherits it.
        fcntl($sock, F_SETFD, 0) or POSIX::_exit(127);
        $ENV{AYE_PROXY_ALLOW} = join("\n", @allow_hosts);
        exec { $^X } $^X, $proxy_helper, '--fd', fileno($sock),
             ($allow_reserved ? '--allow-reserved' : ())
            or POSIX::_exit(127);
    }
    return $pid;
}

sub proxy_log_note {
    my ($log, $msg) = @_;
    open(my $fh, '>>', $log) or return;
    print {$fh} "aye-buddy: $msg\n";
    close $fh;
    return;
}

# Filtered path. aye-buddy becomes a small supervisor: it starts the proxy on
# the host, launches the sandbox under pasta, waits, restarts the proxy if it
# dies, and always kills it at the end. Under pasta the chain is
# pasta -> aye-netns-seal -> bwrap -> claude;
# aye-netns-seal drops the netns default route, rewrites @@AYE_PROXY@@ to the
# proxy URL, and arms the seccomp blob itself (pasta need not preserve fds).
# Never returns: exits with the sandbox's status.
sub launch_filtered {
    # 1. Bind the proxy's listening socket here and hand it to aye-proxy by fd:
    #    the supervisor keeps the port bound for the whole session, so a crashed
    #    proxy can be safely restarted.
    my $logdir;
    my $rundir = $ENV{XDG_RUNTIME_DIR};
    if (defined $rundir && $rundir =~ m{^/} && -d $rundir && -o _) {
        my $dir = "$rundir/aye-buddy";
        eval { make_path($dir, { mode => 0700 }) };  ## no critic (ProhibitLeadingZeros)
        $logdir = $dir if -d $dir && -o _;
    }
    $logdir //= eval { File::Temp::tempdir('aye-buddy.XXXXXX', TMPDIR => 1) }
        // fail("cannot create a private log dir: " . ($@ =~ s/\s+\z//r));
    my $proxy_log = "$logdir/aye-proxy.$$.log";
    my $pasta_log = "$logdir/aye-pasta.$$.log";
    if ($ENV{AYE_BUDDY_DEBUG}) {
        warning("egress proxy log: $proxy_log");
        warning("pasta log: $pasta_log");
    }
    my $proxy_sock = IO::Socket::INET->new(
        Listen    => 128,
        LocalAddr => '127.0.0.1',
        LocalPort => 0,
        ReuseAddr => 1,
        Proto     => 'tcp',
    ) or fail("listen for aye-proxy: $!");
    my $proxy_port = $proxy_sock->sockport;

    my $proxy_pid = spawn_proxy($proxy_sock, $proxy_log) // fail("fork proxy: $!");

    # 2. Run the sandbox under pasta. '-' when seccomp is off tells the helper not
    #    to arm the blob.
    my $blob_arg = $use_seccomp ? $seccomp_blob : '-';
    # --quiet + log-to-file keep pasta's own diagnostics (the IPv6 "local mode"
    # notes and friends) off the shared terminal, where they'd clutter claude's TUI.
    # IPv6 is sealed inside the netns by aye-netns-seal (it drops the v6 default
    # route too), not with pasta --ipv4-only — that flag broke pasta's netns setup
    # on some hosts, so we leave pasta's dual-stack default and seal at the routes.
    my @launch = ('pasta', '--config-net', '--quiet', '--log-file', $pasta_log, '--',
                  $^X, $netns_seal, $proxy_port, $blob_arg,
                  ($allow_subnet ? '--allow-subnet' : ()), '--',
                  'bwrap', @args);
    my $sandbox_pid = fork // fail("fork sandbox: $!");
    if ($sandbox_pid == 0) {
        exec { $launch[0] } @launch
            or POSIX::_exit(127);
    }

    # 3. Supervise: forward terminating signals to the sandbox and wait on both
    #    children. Sandbox first is the normal path: tear the proxy down and
    #    propagate the exit status. A proxy death is invisible from inside the
    #    session (egress just goes dead), so the supervisor restarts it — the
    #    listening socket is still bound, so waiting clients queue in the backlog
    #    rather than getting refused. A proxy that keeps dying is a bug, not a
    #    wobble: past the cap the session is faulted, with the message printed
    #    after the TUI is gone and the proxy log kept as the only evidence.
    my $MAX_PROXY_RESTARTS = 5;
    $SIG{$_} = sub { kill $_[0], $sandbox_pid } for qw(INT TERM HUP);
    my $status;
    my $proxy_died = 0;
    my $restarts = 0;
    while (1) {
        my $pid = waitpid(-1, 0);
        if ($pid == $sandbox_pid) { $status = $?; last }
        if (defined $proxy_pid && $pid == $proxy_pid) {
            my $replacement;
            if ($restarts < $MAX_PROXY_RESTARTS) {
                $restarts++;
                proxy_log_note($proxy_log, "aye-proxy exited (status $?); restarting ($restarts/$MAX_PROXY_RESTARTS)");
                $replacement = spawn_proxy($proxy_sock, $proxy_log);
            }
            if (defined $replacement) {
                $proxy_pid = $replacement;
            } else {
                # Cap exhausted, or the respawn fork itself failed: fault.
                $proxy_pid = undef;
                $proxy_died = 1;
                kill 'TERM', $sandbox_pid;
            }
            next;
        }
        last if $pid < 0 && $! != EINTR;    # no children left; can't happen
    }
    if (defined $proxy_pid) {
        kill 'TERM', $proxy_pid;
        waitpid($proxy_pid, 0);
    }
    # Drop the helper logs on a clean exit; keep them under debug for inspection —
    # or whenever the proxy died, since the log is the only record of why.
    if ($proxy_died) {
        unlink $pasta_log unless $ENV{AYE_BUDDY_DEBUG};
        fail("aye-proxy kept dying ($restarts restarts); session terminated (log: $proxy_log)");
    }
    if ($restarts) {
        warning("aye-proxy died and was restarted $restarts time(s) this session (log: $proxy_log)");
        unlink $pasta_log unless $ENV{AYE_BUDDY_DEBUG};
    } else {
        unless ($ENV{AYE_BUDDY_DEBUG}) { unlink $proxy_log, $pasta_log; rmdir $logdir }
    }
    exit($status & 127 ? 128 + ($status & 127) : $status >> 8);
}

if ($net_filter) {
    launch_filtered();
} else {
    launch_unfiltered();
}
