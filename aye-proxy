#!/usr/bin/env perl
# aye-proxy: minimal filtering HTTP CONNECT proxy for aye-buddy.
#
# It is the single egress point for the sandbox netns: the netns has no route
# to the internet except this proxy, so every outbound TCP connection arrives
# here as a CONNECT and is allowed only if its target host is on the allowlist.
# A raw-socket reverse shell has no CONNECT verb and no route of its own, so it
# cannot get out. TLS is tunnelled untouched (no interception), so the allow
# decision is made from the client-supplied host — same trade-off as claude's
# own sandbox proxy: cheap and transparent, but spoofable via SNI/domain-front.
#
# Allowlist entries come from --allow (repeatable) and the newline-separated
# AYE_PROXY_ALLOW env (so the full list needn't show up in `ps`). Each entry is
# HOST or .HOST, with an optional :PORT; a port-less entry permits 443 (this
# proxy serves CONNECT only, so plain HTTP can't work anyway), a :PORT entry
# permits exactly that port. HOST matches that name and nothing else, so
# whoever can create a record under the domain can't pick our destination;
# .HOST gives that up for every name under it, and needs two labels so a bare
# suffix can't hand over a TLD. Everything else gets 403.
#
# The client is an untrusted sandbox, so resource use is bounded: at most
# AYE_PROXY_MAX_CONNS concurrent tunnels (default 256; excess get 503), plus
# connect/header/idle timeouts so a stalled peer can't pin a slot indefinitely.
use strict;
use warnings;
use IO::Socket::INET;
use IO::Select;
use Getopt::Long qw(GetOptions);
use POSIX qw(WNOHANG);
use Errno qw(EINTR);

# Resource-bound knobs (see header): a ceiling on concurrent tunnels, each a
# forked process + fd pair, and timeouts so a stalled peer can't hold a slot.
my $MAX_CONNS = ($ENV{AYE_PROXY_MAX_CONNS} // '') =~ /\A[0-9]+\z/
    ? $ENV{AYE_PROXY_MAX_CONNS} + 0 : 256;
my $CONNECT_TIMEOUT = 10;      # origin connect
my $HEADER_TIMEOUT  = 30;      # deadline for the whole CONNECT header
my $IDLE_TIMEOUT    = 1800;    # reap a tunnel idle in both directions

my (@allow, $fd);
GetOptions('allow=s' => \@allow, 'fd=i' => \$fd)
    or die "aye-proxy: bad options\n";
defined $fd or die "aye-proxy: --fd is required\n";
push @allow, grep { length } split /\n/, ($ENV{AYE_PROXY_ALLOW} // '');

# Parse each entry once into [host, port|undef, subdomains?].
my @entries;
for my $e (@allow) {
    my ($h, $p) = $e =~ /\A(.+?)(?::([0-9]+))?\z/;
    next unless defined $h;
    my $subs = $h =~ s/\A\.//;
    # A bare '.' would leave nothing to compare and match on the suffix alone.
    next unless length $h;
    # '.com' would open every host under the TLD, which no caller means; drop it
    # here as well as at the CLI, since this is where the rule has to hold.
    if ($subs && $h !~ /\./) {
        warn "aye-proxy: ignoring allowlist entry '" . ascii_sanitise($e)
           . "': .HOST needs at least two labels\n";
        next;
    }
    push @entries, [ lc $h, defined $p ? $p + 0 : undef, $subs ];
}

# Replace control bytes with '?' so a hostile value can't inject terminal
# escapes into a log an operator may later cat.
sub ascii_sanitise {
    (my $s = shift) =~ s/[^\x21-\x7e]/?/g;
    return $s;
}

sub connect_allowed {
    my ($h, $p) = @_;
    $h = lc $h;
    for my $e (@entries) {
        my ($eh, $ep, $subs) = @$e;
        next unless $h eq $eh || ($subs && $h =~ /\.\Q$eh\E\z/);
        return 1 if defined $ep ? $p == $ep : $p == 443;
    }
    return 0;
}


# A tunnel peer can vanish mid-write; without this, syswrite's SIGPIPE kills the
# child instead of returning an error pump() can act on.
$SIG{PIPE} = 'IGNORE';

# Reap children as they exit and keep a live count for the cap below. (A plain
# SIG_IGN would auto-reap but leave nothing to count, so the cap couldn't tell
# how many tunnels are open.)
my (%kids, %reaped);
$SIG{CHLD} = sub {
    while ((my $pid = waitpid(-1, WNOHANG)) > 0) {
        delete $kids{$pid} or $reaped{$pid} = 1;
    }
};

# On shutdown, tear down live tunnels too.
$SIG{TERM} = $SIG{INT} = sub { kill 'TERM', keys %kids; exit 0 };

# The launcher binds the listening socket and hands it over by fd; it keeps
# the socket bound across proxy restarts, so the port is never free for
# another local user to claim between one proxy and the next.
my $srv = IO::Socket::INET->new_from_fd($fd, '+<')
    or die "aye-proxy: fd $fd: $!\n";

while (1) {
    my $client = $srv->accept;
    unless ($client) {
        next if $! == EINTR;    # SIGCHLD interrupted accept; just retry
        last;                   # a real listen-socket error: stop
    }
    # Shed load past the cap rather than fork an unbounded number of processes.
    if (keys %kids >= $MAX_CONNS) {
        reply($client, 503, 'Service Unavailable');
        next;
    }
    my $pid = fork;
    if ($pid)          { delete $reaped{$pid} or $kids{$pid} = 1; next }
    if (!defined $pid) { warn "aye-proxy: fork: $!\n"; close $client; next }
    close $srv;               # child: handle one connection
    handle($client);
    exit 0;
}

sub handle {
    my ($client) = @_;
    $client->autoflush(1);

    my ($host, $dport, $rest) = read_connect_request($client);
    return unless defined $host;

    unless (connect_allowed($host, $dport)) {
        warn "aye-proxy: DENY ", ascii_sanitise("$host:$dport"), "\n";
        return reply($client, 403, 'Blocked by allowlist');
    }

    my $origin = IO::Socket::INET->new(
        PeerHost => $host, PeerPort => $dport, Proto => 'tcp',
        Timeout => $CONNECT_TIMEOUT,
    );
    return reply($client, 502, 'Bad Gateway') unless $origin;
    $origin->autoflush(1);
    print $client "HTTP/1.1 200 Connection established\r\n\r\n";

    # Hand the tunnel whatever the client pipelined behind its CONNECT before
    # pump() takes over, or those bytes are lost.
    if (length $rest && !write_all($origin, $rest)) {
        close $client; close $origin;
        return;
    }
    pump($client, $origin);
}

# Read the CONNECT request line and headers from $client. Returns
# (host, port, leftover), where leftover is any bytes the client sent after the
# blank line: TCP has no message boundaries, so a client that doesn't wait for
# our 200 lands its first tunnel payload in the same read as the request, and
# dropping it strands the peer on a handshake that never completes.
# Returns () after replying with an error if the request never arrives, is
# oversized, isn't a CONNECT, or names a host that isn't a plain hostname.
sub read_connect_request {
    my ($client) = @_;
    # One deadline for the whole header
    my $csel = IO::Select->new($client);
    my $deadline = time + $HEADER_TIMEOUT;
    my $buf = '';
    while ($buf !~ /\r?\n\r?\n/) {
        my $left = $deadline - time;
        return reply($client, 408, 'Request Timeout')
            if $left <= 0 || !$csel->can_read($left);
        my $n = sysread($client, my $chunk, 4096);
        last unless $n;
        $buf .= $chunk;
        return reply($client, 400, 'Bad Request') if length $buf > 65536;
    }
    # Split at the header terminator. No match means the client hung up early;
    # the request-line check below then rejects it.
    my ($head, $rest) = $buf =~ /\A(.*?\r?\n\r?\n)(.*)\z/s ? ($1, $2) : ($buf, '');

    my ($line) = split /\r?\n/, $head, 2;
    $line //= '';
    # CONNECT host:port HTTP/1.x — the only verb we serve. Plain-HTTP proxying
    # is intentionally unsupported: the allowlisted hosts are all HTTPS, and
    # deny-by-default is the safe posture.
    my ($host, $dport) = $line =~ m{\ACONNECT\s+([^\s:]+):([0-9]+)\s}i;
    return reply($client, 405, 'Method Not Allowed',
        "aye-proxy tunnels CONNECT only; plain-HTTP proxying is unsupported. Use https://\n")
        unless defined $host;
    # The allow decision compares Perl strings; the connect hands the name to the
    # C resolver, which stops at a NUL. Anything outside a hostname's shape opens
    # that gap, so it never reaches either. Same rule --allow-host validates
    # against, since the two are compared to each other.
    unless ($host =~ /\A[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*\z/) {
        warn "aye-proxy: DENY ", ascii_sanitise("$host:$dport"), "\n";
        return reply($client, 403, 'Blocked by allowlist');
    }
    return ($host, $dport, $rest);
}

# syswrite can come up short; loop until the whole buffer is out. Returns false
# if the peer went away mid-write.
sub write_all {
    my ($fh, $buf) = @_;
    my ($off, $len) = (0, length $buf);
    while ($off < $len) {
        my $w = syswrite($fh, $buf, $len - $off, $off);
        return 0 unless $w;
        $off += $w;
    }
    return 1;
}

sub reply {
    my ($client, $code, $msg, $body) = @_;
    $body //= '';
    print $client "HTTP/1.1 $code $msg\r\nContent-Length: ", length $body,
                  "\r\nConnection: close\r\n\r\n", $body;
    close $client;
    return;
}

# Bidirectional byte pump until either side closes or the tunnel goes idle in
# both directions past IDLE_TIMEOUT (reaps half-open tunnels whose peer vanished
# without a FIN, which would otherwise sit forever).
sub pump {
    my ($a, $b) = @_;
    my $sel = IO::Select->new($a, $b);
    while (my @ready = $sel->can_read($IDLE_TIMEOUT)) {
        for my $from (@ready) {
            my $to = $from == $a ? $b : $a;
            my $n = sysread($from, my $buf, 65536);
            if (!$n) { close $a; close $b; return }
            # Write failed (peer gone): tear down rather than drop bytes.
            if (!write_all($to, $buf)) { close $a; close $b; return }
        }
    }
    close $a; close $b;    # can_read returned empty: idle timeout
}
